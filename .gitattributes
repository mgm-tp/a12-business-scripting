#
# https://git-scm.com/docs/gitattributes
#
# Store every text file with LF and check it out with LF on all platforms, so
# that a Windows checkout with core.autocrlf cannot flip the tree to CRLF.
*               text=auto eol=lf

# These are Windows script files and should use crlf
*.bat           text eol=crlf

# Binary files are never converted
*.jar           binary
*.png           binary
